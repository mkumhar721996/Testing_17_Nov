# PostgreSQL connection string (migrations: `pnpm run migrate`, or `node dist/database/migrate.js`).
DATABASE_URL=postgres://user:password@localhost:5432/operations
# Cognito user pool and app client used to verify bearer tokens (ID tokens must carry custom:tenant_id).
# When either is unset, every authenticated request is rejected with 401.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Tests only (ignored when NODE_ENV=production): accept "<sub>:<tenant-uuid>" as a bearer token.
# E2E_FAKE_AUTH=1
