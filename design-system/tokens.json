{
  "color-fg": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.102, 0.1255, 0.1725], "hex": "#1a202c"}, "$description": "Primary text"},
  "color-fg-muted": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.2784, 0.3333, 0.4118], "hex": "#475569"}, "$description": "Secondary text and hints"},
  "color-bg": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff"}, "$description": "Page background"},
  "color-surface": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.9725, 0.9804, 0.9882], "hex": "#f8fafc"}, "$description": "Sunken surface, table headers, hover"},
  "color-surface-2": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.8863, 0.9098, 0.9412], "hex": "#e2e8f0"}, "$description": "Skeleton fill, pressed surface"},
  "color-primary": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.1137, 0.3059, 0.8471], "hex": "#1d4ed8"}, "$description": "Brand and primary actions"},
