  "color-info-bg": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.8588, 0.9176, 0.9961], "hex": "#dbeafe"}, "$description": "Info tint"},
  "color-info-fg": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.1176, 0.2275, 0.5412], "hex": "#1e3a8a"}, "$description": "Text on info tint"},
  "color-success-bg": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.8627, 0.9882, 0.9059], "hex": "#dcfce7"}, "$description": "Success tint"},
  "color-success-fg": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.0784, 0.3255, 0.1765], "hex": "#14532d"}, "$description": "Text on success tint"},
  "color-warning-bg": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.9961, 0.9529, 0.7804], "hex": "#fef3c7"}, "$description": "Warning tint"},
  "color-warning-fg": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.4706, 0.2078, 0.0588], "hex": "#78350f"}, "$description": "Text on warning tint"},
  "color-danger-bg": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.9961, 0.8863, 0.8863], "hex": "#fee2e2"}, "$description": "Danger tint"},
  "color-danger-fg": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.498, 0.1137, 0.1137], "hex": "#7f1d1d"}, "$description": "Text on danger tint"},

  "space-1": {"$type": "dimension", "$value": {"value": 4, "unit": "px"}},
