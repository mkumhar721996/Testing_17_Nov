  "radius-sm": {"$type": "dimension", "$value": {"value": 4, "unit": "px"}},
  "radius-md": {"$type": "dimension", "$value": {"value": 8, "unit": "px"}},
  "radius-lg": {"$type": "dimension", "$value": {"value": 12, "unit": "px"}},
  "radius-full": {"$type": "dimension", "$value": {"value": 9999, "unit": "px"}, "$description": "Pills and circles"},

  "font-size-sm": {"$type": "dimension", "$value": {"value": 13, "unit": "px"}},
  "font-size-md": {"$type": "dimension", "$value": {"value": 15, "unit": "px"}},
  "font-size-lg": {"$type": "dimension", "$value": {"value": 18, "unit": "px"}},
  "font-size-xl": {"$type": "dimension", "$value": {"value": 24, "unit": "px"}},

  "border-width": {"$type": "dimension", "$value": {"value": 1, "unit": "px"}},
  "control-height-sm": {"$type": "dimension", "$value": {"value": 28, "unit": "px"}},
  "control-height-md": {"$type": "dimension", "$value": {"value": 36, "unit": "px"}},
  "control-height-lg": {"$type": "dimension", "$value": {"value": 44, "unit": "px"}},
  "icon-size": {"$type": "dimension", "$value": {"value": 16, "unit": "px"}},
  "switch-width": {"$type": "dimension", "$value": {"value": 36, "unit": "px"}},
  "avatar-size": {"$type": "dimension", "$value": {"value": 32, "unit": "px"}},
  "sidebar-width": {"$type": "dimension", "$value": {"value": 232, "unit": "px"}, "$description": "App shell navigation"},
  "drawer-width": {"$type": "dimension", "$value": {"value": 360, "unit": "px"}},
  "modal-width": {"$type": "dimension", "$value": {"value": 480, "unit": "px"}},
  "toast-width": {"$type": "dimension", "$value": {"value": 320, "unit": "px"}},
  "content-max-width": {"$type": "dimension", "$value": {"value": 1200, "unit": "px"}},
  "dropdown-min-width": {"$type": "dimension", "$value": {"value": 180, "unit": "px"}},
  "breakpoint-md": {"$type": "dimension", "$value": {"value": 768, "unit": "px"}, "$description": "Sidebar collapses below this width (reference; media queries mirror it)"},

  "font-family-base": {"$type": "fontFamily", "$value": "system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif", "$description": "UI text"},
  "font-family-mono": {"$type": "fontFamily", "$value": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace", "$description": "IDs, logs, code"},
  "font-weight-regular": {"$type": "fontWeight", "$value": 400},
  "font-weight-semibold": {"$type": "fontWeight", "$value": 600},
  "line-height-base": {"$type": "number", "$value": 1.5},
  "opacity-backdrop": {"$type": "number", "$value": 0.5, "$description": "Backdrop opacity over color-fg"},
  "opacity-disabled": {"$type": "number", "$value": 0.5},
  "z-popup": {"$type": "number", "$value": 50},
  "z-overlay": {"$type": "number", "$value": 100},

  "duration-fast": {"$type": "duration", "$value": {"value": 150, "unit": "ms"}},
  "duration-spin": {"$type": "duration", "$value": {"value": 800, "unit": "ms"}},

  "shadow-md": {"$type": "shadow", "$value": {"color": {"colorSpace": "srgb", "components": [0.102, 0.1255, 0.1725], "hex": "#1a202c"}, "offsetX": {"value": 0, "unit": "px"}, "offsetY": {"value": 4, "unit": "px"}, "blur": {"value": 12, "unit": "px"}, "spread": {"value": 0, "unit": "px"}}, "$description": "Popups and cards"},
  "shadow-lg": {"$type": "shadow", "$value": {"color": {"colorSpace": "srgb", "components": [0.102, 0.1255, 0.1725], "hex": "#1a202c"}, "offsetX": {"value": 0, "unit": "px"}, "offsetY": {"value": 8, "unit": "px"}, "blur": {"value": 24, "unit": "px"}, "spread": {"value": 0, "unit": "px"}}, "$description": "Modal and drawer"},

  "button-primary-background": {"$type": "color", "$value": "{color-primary}"},
  "button-primary-background-hover": {"$type": "color", "$value": "{color-primary-hover}"},
  "button-primary-foreground": {"$type": "color", "$value": "{color-on-primary}"},
  "button-secondary-background": {"$type": "color", "$value": "{color-bg}"},
  "button-secondary-background-hover": {"$type": "color", "$value": "{color-surface}"},
  "button-secondary-foreground": {"$type": "color", "$value": "{color-fg}"},
  "button-secondary-border": {"$type": "color", "$value": "{color-border}"},
  "button-ghost-foreground": {"$type": "color", "$value": "{color-primary}"},
  "button-ghost-background-hover": {"$type": "color", "$value": "{color-surface}"},
  "button-danger-background": {"$type": "color", "$value": "{color-danger}"},
  "button-danger-background-hover": {"$type": "color", "$value": "{color-danger-hover}"},
  "button-danger-foreground": {"$type": "color", "$value": "{color-on-primary}"},
  "button-default-radius": {"$type": "dimension", "$value": "{radius-md}"},
  "button-default-padding-x": {"$type": "dimension", "$value": "{space-3}"},
  "button-default-font-size": {"$type": "dimension", "$value": "{font-size-md}"},

  "card-default-background": {"$type": "color", "$value": "{color-bg}"},
  "card-default-border": {"$type": "color", "$value": "{color-border-subtle}"},
  "card-default-radius": {"$type": "dimension", "$value": "{radius-lg}"},
  "card-default-padding": {"$type": "dimension", "$value": "{space-3}"},
  "card-default-shadow": {"$type": "shadow", "$value": "{shadow-md}"}
}
